{
  "name": "amudia",
  "version": "0.1.0",
  "private": true,
  "description": "Stream licensed, public-domain, and user-owned media",
  "author": "Moughamir (https://github.com/moughamir)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moughamir/amudia.git"
  },
  "homepage": "https://github.com/moughamir/amudia#readme",
  "bugs": {
    "url": "https://github.com/moughamir/amudia/issues"
  },
  "workspaces": [
    "shared",
    "contracts",
    "api",
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "generate:types": "turbo run generate --filter=@amudia/contracts",
    "build:types": "turbo run build --filter=@amudia/contracts",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "prepare": "husky",
    "changelog": "standard-version --dry-run",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "standard-version": "^9.5.0",
    "turbo": "^2.9.18",
    "typescript": "^5.5.0"
  },
  "packageManager": "bun@1.3.14"
}
