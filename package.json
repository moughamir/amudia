{
  "name": "media-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "contracts",
    "api",
    "web",
    "worker"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "generate:types": "turbo run generate --filter=@media/contracts",
    "build:types": "turbo run build --filter=@media/contracts",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "bun@1.3.14"
}
