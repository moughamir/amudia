{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"],
      "@amudia/contracts": ["../contracts/src/index.ts"],
      "@amudia/contracts/*": ["../contracts/src/*"],
      "@amudia/shared": ["../shared/index.ts"],
      "@amudia/shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*"]
}
