{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@amudia/contracts": ["../contracts/src/index.ts"],
      "@amudia/contracts/*": ["../contracts/src/*"]
    }
  },
  "include": [
    "core/**/*",
    "domain/**/*",
    "infrastructure/**/*",
    "application/**/*",
    "types/**/*"
  ]
}